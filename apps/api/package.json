{
  "name": "@pulse/api",
  "version": "0.1.0",
  "private": true,
  "description": "BiltFlow Pulse API \u2014 NestJS + PostgreSQL scheduling backend",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:sqlite": "node -r dotenv/config dist/dev-main.js",
    "test": "jest --config jest.config.cjs",
    "db:migrate": "node -r dotenv/config ../../node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "db:migrate:generate": "node dist/database/generate-migration.js",
    "db:seed": "node -r dotenv/config dist/database/seed.js",
    "db:migrate:revert": "node -r dotenv/config ../../node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/deepseek": "^0.1.0",
    "@langchain/langgraph": "^0.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-ws": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@pulse/engine": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fast-xml-parser": "^4.5.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.5.0",
    "better-sqlite3": "^12.2.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  }
}